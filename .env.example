# FantasyDraftTracker environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ---------------------------------------------------------------------------
# DistributedDatabaseSystem player DB integration
# ---------------------------------------------------------------------------

# HTTP base URL of the running DistributedDatabaseSystem server.
# Start it with: scripts/start_player_db.sh
PLAYER_DB_URL=http://localhost:8090

# Bearer token configured via -api-keys on the DB server.
PLAYER_DB_API_KEY=fantasy-draft-key

# Set to "true" to activate DB-backed player loading.
# When false (default), the app reads players_YEAR.json from data/processed/ as usual.
USE_PLAYER_DB=false
